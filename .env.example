# --- Telegram ---
# Создаётся через @BotFather. Не забудь у BotFather: /setprivacy → Disable
# (иначе бот в группе будет видеть только свои упоминания).
TELEGRAM_BOT_TOKEN=

# Численный chat_id рабочей супергруппы (для супергрупп с форумом — отрицательный, начинается с -100...).
# Узнать: добавь бота, отправь любое сообщение, посмотри в логах bot или https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# message_thread_id forum-топика, в который бот будет постить дневные батчи и задавать
# вопросы команде. Создай в супергруппе forum-топик "DuckSidian", скопируй id из ссылки на топик.
TELEGRAM_TOPIC_ID=

# Список user_id админов через запятую — кто может вызывать /lint, /pause, /resume, /ingest, /model, /allow.
TELEGRAM_ADMINS=

# --- Личный режим (DM с ботом) ---
# user_id сотрудников, которым разрешено личное пространство (через запятую). Админы — всегда.
# Можно дополнять в рантайме: /allow <id> (хранится в БД). Свой id пользователь видит по /start в личке.
TELEGRAM_PRIVATE_USERS=
# Бюджет шагов агента на одно сообщение в личке и сколько реплик диалога подмешивать как контекст.
PERSONAL_AGENT_MAX_STEPS=20
PERSONAL_HISTORY_SIZE=12

# --- Мультичат (опционально) ---
# Формат: "chat_id:name[:topic_id]|chat_id:name[:topic_id]|..."
# Пример: "-10012345678:main:456|-10087654321:sales:"
# Если пусто — используется TELEGRAM_CHAT_ID + TELEGRAM_TOPIC_ID как единственный чат.
# Имя (name) = слаг поддиректории vault: vault/main/, vault/sales/ и т.д.
TELEGRAM_CHATS=

# --- LLM: мульти-вендор (OpenAI-compatible chat/completions + tool-calling) ---
# Провайдер по умолчанию: deepseek | minimax | qwen | openai | openrouter | ollama | custom
# Переключить в рантайме: /model <provider> [model] (admin). Выбор сохраняется в БД.
LLM_PROVIDER=deepseek
# Переопределения для активного провайдера (опционально):
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Ключи вендоров — задай те, между которыми хочешь переключаться:
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=          # https://platform.minimax.io  (модели MiniMax-M2.1, MiniMax-M2)
QWEN_API_KEY=        # Qwen (qwen3.7-plus, qwen3.8-max, qwen3.8-flash)
# Эндпоинт Qwen (по умолчанию token-plan; для DashScope: https://dashscope-intl.aliyuncs.com/compatible-mode/v1)
QWEN_BASE_URL=https://token-plan.maas.qwencloudapi.com/compatible-mode/v1
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Для китайских эндпоинтов вместо международных:
#   MiniMax:  LLM_BASE_URL=https://api.minimaxi.com/v1
#   Qwen:     QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Медиа-ИИ через MiniMax (речь → текст, текст → речь, зрение, картинки) ---
# auto = использовать MiniMax, если задан MINIMAX_API_KEY; иначе локальный fallback
# (Whisper для STT, Ollama moondream для vision, TTS/картинки выключены). off — выключить.
STT_PROVIDER=auto          # auto | minimax | whisper | off   (ASR: asr-1.0, язык STT_LANGUAGE)
STT_LANGUAGE=ru
VISION_PROVIDER=auto       # auto | minimax | ollama | off    (MiniMax-M3 смотрит фото/кадры видео)
TTS_PROVIDER=auto          # auto | minimax | off             (speech-2.8-hd)
IMAGE_PROVIDER=auto        # auto | minimax | off             (image-01, /imagine и tool generate_image)
MINIMAX_TTS_VOICE=Russian_ReliableMan   # /voices — другие русские голоса
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_VISION_MODEL=MiniMax-M3
# Голосовые ответы в личке: auto (голосом на голосовые) | on | off; per-user: /voice
PERSONAL_VOICE_REPLY=auto
# Fallback STT без MiniMax — openai-whisper: tiny | base | small | medium | large (для русского — минимум small).
WHISPER_MODEL=small

# --- Расписание ingest (cron, TZ из переменной TZ) ---
# По умолчанию 23:00 каждый день.
INGEST_CRON=0 23 * * *
TZ=Europe/Moscow

# --- Пути (в docker задаются compose'ом; при запуске без docker — абсолютные пути) ---
# VAULT_PATH=/абсолютный/путь/к/DuckSidian/vault
# DATA_PATH=/абсолютный/путь/к/DuckSidian/bot/data

# --- Obsidian web (KasmVNC) ---
OBSIDIAN_USER=admin
OBSIDIAN_PASSWORD=changeme
OBSIDIAN_PORT=3000

# --- Git auto-sync (опционально) ---
# Если задан — vault будет коммитить и пушить после каждого ingest/lint.
GIT_AUTOCOMMIT=true
GIT_REMOTE_URL=
GIT_USER_NAME=DuckSidian Bot
GIT_USER_EMAIL=ducksidian@localhost
